# ForgeGuard environment configuration
# Copy this to .env and fill in your values.
# Never commit .env to version control.

# ─── Bob Shell / CLI ─────────────────────────────────────────────────────────
# Authentication key for Bob Shell non-interactive sessions.
# Set this to your API key from the Bob web portal (Scope: Inference).
BOBSHELL_API_KEY=

# Absolute path to the bob CLI executable (defaults to "bob" on PATH).
BOB_CLI_PATH=bob

# Approval mode for Bob Shell: "default" | "auto_edit" | "full_auto"
# Use "auto_edit" for automated pipeline execution.
BOB_APPROVAL_MODE=auto_edit

# ─── ForgeGuard Bob provider ──────────────────────────────────────────────────
# Which provider to use as primary: "shell" | "api"
BOB_PROVIDER=shell

# ─── Bob REST API (secondary / fallback) ────────────────────────────────────
# Only needed if BOB_PROVIDER=api or as a fallback.
BOB_API_URL=
BOB_API_KEY=

# ─── Bob workspace ────────────────────────────────────────────────────────────
# Absolute path to the workspace Bob should operate in for pipeline tasks.
# Defaults to the demo-app directory relative to the backend.
BOB_WORKSPACE=

# Timeout in milliseconds for a single Bob task (default: 120000 = 2 minutes).
BOB_TIMEOUT_MS=120000

# Maximum turns Bob is allowed per task (default: 30).
BOB_MAX_TURNS=30

# ─── Backend server ───────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Interface to listen on. Default 127.0.0.1 (this machine only). Set another
# address (e.g. 0.0.0.0) only on purpose: the API has no authentication.
FORGEGUARD_HOST=

# ─── Security (docs/SECURITY_MODEL.md) ────────────────────────────────────────
# Absolute paths of the repositories missions may target, separated by ';' on
# Windows and ':' elsewhere. Empty = only the bundled demo-app.
FORGEGUARD_ALLOWED_REPOS=

# Comma-separated browser origins allowed to call the API and open the WebSocket.
# Empty = http://localhost:5173,http://127.0.0.1:5173 (the Vite dev server). '*' is ignored.
FORGEGUARD_ALLOWED_ORIGINS=

# ─── Validation (docs/VALIDATION_POLICY.md) ───────────────────────────────────
# Per-command timeout for lint/test/typecheck/build. Empty = 180000 (3 minutes).
FORGEGUARD_VALIDATION_TIMEOUT_MS=

# ─── Database ────────────────────────────────────────────────────────────────
# Path to the SQLite database file (relative to backend/).
# Defaults to backend/data/forgeguard.db
DB_PATH=./data/forgeguard.db
